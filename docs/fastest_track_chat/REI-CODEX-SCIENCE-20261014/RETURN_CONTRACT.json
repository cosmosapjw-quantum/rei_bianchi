{
  "schema": "rei.codex.return-contract/1",
  "purpose": "Record observed work and scientific scope without fabricated success",
  "required_fields": [
    "task_id",
    "status",
    "execution_identity",
    "source_identities",
    "config_identities",
    "commands",
    "outputs",
    "claim",
    "reused_evidence",
    "failures",
    "next_ready",
    "publication"
  ],
  "allowed_status": [
    "NOT_RUN",
    "RUNNING",
    "COMPLETE_SCOPED",
    "HOLD",
    "BLOCKED",
    "FAILED",
    "NO_GO"
  ],
  "rules": [
    "Every executed command includes exit_code; unexecuted commands use null and executed=false",
    "Record actual output paths and source/config IDs; unavailable values remain null",
    "Report numerical/atomic/source/geometry/closure errors separately",
    "requested model is not observed model; native agent not exposed is NOT_EXPOSED",
    "Push success requires actual remote SHA readback; planned PR IDs are not GitHub numbers",
    "Report is mandatory even if physical claim is HOLD",
    "Independent review must be by an executor that did not implement the reviewed diff"
  ],
  "example": {
    "task_id": null,
    "status": "NOT_RUN",
    "execution_identity": {
      "requested_role": null,
      "requested_model": null,
      "observed_model": null,
      "observed_identity_basis": null,
      "model_substitution": null,
      "native_delegation": "NOT_OBSERVED",
      "executor": null,
      "independent_reviewer": null
    },
    "source_identities": [],
    "config_identities": [],
    "commands": [
      {
        "command": null,
        "cwd": null,
        "executed": false,
        "exit_code": null,
        "wall_seconds": null,
        "cpu_seconds": null,
        "peak_rss_bytes": null,
        "stdout_path": null,
        "stderr_path": null
      }
    ],
    "outputs": {
      "raw_data": [],
      "plots": [],
      "report": null,
      "checkpoint": null,
      "derivation": null
    },
    "claim": {
      "status": "NOT_ADMITTED",
      "scope": null,
      "model_interval": null,
      "representation": null,
      "observer_tail": null,
      "acceptance_observed": [],
      "unknown_fields": [],
      "error_components": {
        "numerical": null,
        "atomic": null,
        "source": null,
        "geometry": null,
        "spectral_spatial_closure": null
      },
      "excluded_claims": []
    },
    "reused_evidence": [],
    "failures": [],
    "next_ready": [],
    "publication": {
      "planned_pr_id": null,
      "commit_sha": null,
      "push_attempted": false,
      "push_exit_code": null,
      "remote_sha": null,
      "sha_match": null,
      "github_pr_number": null,
      "draft_pr_url": null
    }
  }
}
