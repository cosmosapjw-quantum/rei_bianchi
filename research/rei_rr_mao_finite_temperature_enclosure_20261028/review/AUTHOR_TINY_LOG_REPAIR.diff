+def natural_log(x):
+    """Outward log with exact ln(1)=0 endpoints, avoiding fake subnormals.
+
+    Other endpoints retain correctly-rounded HALF_EVEN plus one outward
+    neighbour, exactly as the pinned primitive. Dependency remains unchanged.
+    """
+    from decimal import localcontext,ROUND_HALF_EVEN
+    if x.lo<=0:raise ValueError('positive log interval required')
+    with localcontext(x.a.context) as c:
+        c.rounding=ROUND_HALF_EVEN
+        lo=D(0) if x.lo==1 else c.ln(x.lo).next_minus(c)
+        hi=D(0) if x.hi==1 else c.ln(x.hi).next_plus(c)
+    return Interval(x.a,lo,hi)
 
 
