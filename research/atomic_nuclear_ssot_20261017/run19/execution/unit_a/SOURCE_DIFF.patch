+    let mut args=std::env::args().skip(1);
+    while let Some(a)=args.next(){match a.as_str(){
+        "--probe"=>probe=true,
+        "--target-evaluations"=>target=args.next().unwrap().parse().unwrap(),
+        "--repetitions"=>repeats=args.next().unwrap().parse().unwrap(),
