+                - 6.0 * row.s * row.s)
+                / (2.0 * row.h);
+            let re = (row.dhdx - hp).abs() / hp.abs().max(1e-300);
+            max_raychaudhuri_normalized = max_raychaudhuri_normalized.max(re);
+            if (row.dhdx - hp).abs() > 1e-26 + 3e-12 * hp.abs() {
