+            let rho = parts[rhoi]
+                .parse::<f64>()
+                .map_err(|_| bad("BASS_SOURCE_CSV_NUMBER"))?;
+            let pressure = parts[pi]
+                .parse::<f64>()
+                .map_err(|_| bad("BASS_SOURCE_CSV_NUMBER"))?;
+            if !rho.is_finite()
+                || !pressure.is_finite()
+                || rho < 0.0
+                || pressure < 0.0
+                || pressure > rho / 3.0 + 1e-19
