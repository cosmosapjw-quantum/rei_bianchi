+    pub producer_commit: String,
+    pub source_csv_sha256: String,
+    pub source_manifest_sha256: String,
+    pub case: String,
+    pub grid_points: usize,
+}
+#[derive(Clone, Copy, Debug)]
+struct Row {
+    x: f64,
+    a: f64,
+    t: f64,
+    b: f64,
+    h: f64,
+    s: f64,
+    hf: f64,
+    dhdx: f64,
