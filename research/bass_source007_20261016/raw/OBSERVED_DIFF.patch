+                Ok(v)
+            };
+            let row = Row {
+                x: num(1)?,
+                a: num(2)?,
+                t: num(3)?,
+                b: num(4)?,
+                h: num(5)?,
+                s: num(6)?,
+                hf: num(7)?,
+                dhdx: num(8)?,
