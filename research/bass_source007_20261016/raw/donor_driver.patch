+        let mut next=self.tentative(s,s.a*dln_a.exp(),&mut counter)?;
+        next.rhs_evaluations=counter;
+        next.accepted=s.accepted+1;
+        next.attempts=s.attempts+1;
+        next.next_dln_a=dln_a;
+        *s=next;
+        Ok(())
+    }
