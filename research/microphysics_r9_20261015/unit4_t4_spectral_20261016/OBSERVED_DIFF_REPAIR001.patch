+def carried_deadline_seconds(deadline_utc, now_epoch=None):
+    """Seconds remaining on the original allocation, including prior runs."""
+    deadline = dt.datetime.fromisoformat(deadline_utc.replace('Z', '+00:00'))
+    require(deadline.tzinfo is not None, 'deadline must be timezone-aware')
+    return deadline.timestamp() - (time.time() if now_epoch is None else now_epoch)
+
+
+def symmetric_integrals(h_raw, eri_raw):
+    """Apply the one approved real h and packed-ERI symmetry repair."""
+    require(np.isrealobj(h_raw) and np.isrealobj(eri_raw), 'real integral arrays required')
+    require(h_raw.ndim == 2 and h_raw.shape[0] == h_raw.shape[1], 'invalid h shape')
+    pair_count = h_raw.shape[0] * (h_raw.shape[0] + 1) // 2
+    require(eri_raw.shape == (pair_count, pair_count), 'invalid packed ERI shape')
+    h_skew = h_raw - h_raw.T
+    eri_skew = eri_raw - eri_raw.T
+    h_work = (h_raw + h_raw.T) / 2
+    eri_work = (eri_raw + eri_raw.T) / 2
+    measurements = {
+        'h_raw_symmetry_fro': float(np.linalg.norm(h_skew)),
+        'h_correction_fro': float(np.linalg.norm(h_work - h_raw)),
+        'eri_raw_symmetry_fro': float(np.linalg.norm(eri_skew)),
+        'eri_correction_fro': float(np.linalg.norm(eri_work - eri_raw)),
+        'packed_eri_shape': list(eri_raw.shape),
+    }
+    return h_work, eri_work, measurements
+
