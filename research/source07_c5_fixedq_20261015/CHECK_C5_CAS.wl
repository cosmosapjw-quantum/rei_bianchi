(* C1 local Wolfram Engine + actual xAct checkpoint, source-only baseline *)
ClearAll["Global`*"];
Needs["xAct`xCoba`"];
xAct`xTensor`$DefInfoQ=False;
scalar=<||>;
ClearAll[muC,rpC,rzC,enC,akC,scaleC,qrC,hhC];
rC=Sqrt[rpC^2(1-muC^2)+rzC^2 muC^2];
jC=rpC^2 rzC/rC^3;
scalar["J_mu"]=FullSimplify[D[muC rzC/rC,muC]-jC,Assumptions->rpC>0&&rzC>0&&-1<muC<1];
scalar["source_RJ"]=FullSimplify[rC jC-rpC^2 rzC/rC^2,Assumptions->rpC>0&&rzC>0&&-1<muC<1];
scalar["J_boundary"]=FullSimplify[((muC rzC/rC)/.muC->1)-((muC rzC/rC)/.muC->-1)-2,Assumptions->rpC>0&&rzC>0];
scalar["q_even_clock"]=FullSimplify[Sqrt[hhC^2+qrC^2 akC^2]-Sqrt[hhC^2+(-qrC)^2 akC^2]];
scalar["FLRW_final_support"]=FullSimplify[100*21/5-420];
DefManifold[C1Space,4,{iaC,ibC,icC,idC}];
DefChart[C1Chart,C1Space,{0,1,2,3},{ctC[],xxC[],yyC[],zzC[]}];
Scan[DefScalarFunction,{aC,bC,nC}];
Scan[DefConstantSymbol,{cC,muDirC}];
nowC=ctC[];apC=aC[nowC]Exp[-bC[nowC]];azC=aC[nowC]Exp[2bC[nowC]];
gC=CTensor[DiagonalMatrix[{-1,apC^2,apC^2,azC^2}],{-C1Chart,-C1Chart}];
SetCMetric[gC,C1Chart,SignatureOfMetric->{3,1,0}];
cdC=CovDOfMetric[gC];normalC=CTensor[{1,0,0,0},{C1Chart}];
rayC=CTensor[{1,Sqrt[1-muDirC^2]/apC,0,muDirC/azC},{C1Chart}];
transC=CTensor[{0,1,0,0},{C1Chart}];longC=CTensor[{0,0,0,1},{C1Chart}];
clearC[x_]:=FullSimplify[ToValues[x]];
tensor=<||>;
tensor["unit_normal"]=clearC[normalC[-iaC]normalC[iaC]+1];
tensor["null_ray"]=clearC[rayC[-iaC]rayC[iaC]];
tensor["spatial_Killing_perp"]=clearC[rayC[iaC]rayC[ibC]cdC[-iaC][transC[-ibC]]];
tensor["spatial_Killing_parallel"]=clearC[rayC[iaC]rayC[ibC]cdC[-iaC][longC[-ibC]]];
tensor["directional_redshift"]=clearC[cC rayC[iaC]rayC[ibC]cdC[-iaC][normalC[-ibC]]-cC*(aC'[nowC]/aC[nowC]+bC'[nowC]*(3muDirC^2-1))];
ClearAll[n0,lambda0,lambda1,lambda2,duration,energy,bind0,bind1,bind2,totalLambda,absorbed,parts,heat0,binding0,remaining];
totalLambda=lambda0+lambda1+lambda2;
absorbed=n0(1-Exp[-totalLambda duration]);
parts=absorbed {lambda0,lambda1,lambda2}/totalLambda;
heat0=parts.{energy-bind0,energy-bind1,energy-bind2};
binding0=parts.{bind0,bind1,bind2};
remaining=n0-absorbed;
scalar["frozen_photon_ledger"]=FullSimplify[n0-remaining-Total[parts],Assumptions->totalLambda>0];
scalar["frozen_energy_ledger"]=FullSimplify[energy (n0-remaining)-heat0-binding0,Assumptions->totalLambda>0];
scalar["frozen_zero_time"]=Limit[absorbed,duration->0];
scalar["frozen_initial_rate"]=FullSimplify[(D[absorbed,duration]/.duration->0)-n0 totalLambda];
ClearAll[e0Event,chiEvent,hEvent,lambdaEvent,nEvent,timeEvent,tCrossEvent,tauEvent,aEvent,bEvent,stepEvent,dtEvent,qEvent];
tCrossEvent=Log[e0Event/chiEvent]/hEvent;
scalar["threshold_event_root"]=FullSimplify[e0Event Exp[-hEvent tCrossEvent]-chiEvent,Assumptions->e0Event>chiEvent>0&&hEvent>0];
tauEvent=lambdaEvent tCrossEvent;
scalar["active_survival_partition"]=FullSimplify[nEvent-nEvent Exp[-tauEvent]-nEvent(1-Exp[-tauEvent])];
scalar["redshift_energy_telescope"]=FullSimplify[nEvent (e0Event-aEvent)+(nEvent-qEvent)(aEvent-bEvent)+qEvent aEvent+ (nEvent-qEvent)bEvent-nEvent e0Event];
scalar["midpoint_linear_exact"]=FullSimplify[Integrate[aEvent+bEvent timeEvent,{timeEvent,0,dtEvent}]-dtEvent(aEvent+bEvent dtEvent/2)];
scalar["event_leftpoint_spurious_absorption"]=FullSimplify[(1-Exp[-lambdaEvent dtEvent])/.dtEvent->0];
ClearAll[aEm1,aEm2,eEm1,eEm2,bEm1,bEm2,muEm,qp1,qp2,qz1,qz2,vx,vy,wx,wy,nn1,nn2,lambda1,lambda2];
qp1=aEm1 eEm1 Exp[-bEm1] Sqrt[1-muEm^2];
qz1=aEm1 eEm1 Exp[2 bEm1] muEm;
qp2=aEm2 eEm2 Exp[-bEm2] Sqrt[1-muEm^2];
qz2=aEm2 eEm2 Exp[2 bEm2] muEm;
scalar["same_local_direction_q_ratio"]=FullSimplify[((qz1/qp1)/(qz2/qp2))-Exp[3(bEm1-bEm2)],Assumptions->aEm1>0&&aEm2>0&&eEm1>0&&eEm2>0&&0<muEm<1];
scalar["direction_area_nonzero_if_shear_changes"]=FullSimplify[qp1 qz2-qz1 qp2-aEm1 aEm2 eEm1 eEm2 muEm Sqrt[1-muEm^2] Exp[-bEm1-bEm2](Exp[3bEm2]-Exp[3bEm1]),Assumptions->aEm1>0&&aEm2>0&&eEm1>0&&eEm2>0&&0<muEm<1];
scalar["angle_first_order_shear"]=FullSimplify[(D[ArcTan[Exp[3 b] muEm/Sqrt[1-muEm^2]],b]/.b->0)-3 muEm Sqrt[1-muEm^2],Assumptions->0<muEm<1];
pa={vx,vy};pb={wx,wy};
scalar["triangle_gap_identity"]=FullSimplify[(nn1 Sqrt[pa.pa]+nn2 Sqrt[pb.pb])^2-(nn1 pa+nn2 pb).(nn1 pa+nn2 pb)-2nn1 nn2(Sqrt[(pa.pa)(pb.pb)]-pa.pb),Assumptions->Element[{vx,vy,wx,wy,nn1,nn2},Reals]&&nn1>0&&nn2>0];
scalar["collinear_positive_energy_exact"]=FullSimplify[(nn1 lambda1+nn2 lambda2)Sqrt[vx^2+vy^2]-(nn1 lambda1 Sqrt[vx^2+vy^2]+nn2 lambda2 Sqrt[vx^2+vy^2]),Assumptions->nn1>0&&nn2>0&&lambda1>0&&lambda2>0];
ClearAll[gridN,gridU,gridR,gridRnew,gridLambda,gridDt,gridSurvival,gridLost,gridBinding,gridHeat];
gridSurvival=Exp[-gridLambda gridDt];
gridLost=gridN(1-gridSurvival);
gridBinding=gridLost gridBound;
gridHeat=gridLost(gridR gridU/gridN-gridBound);
scalar["fixed_q_number_survival"]=FullSimplify[gridN-gridN gridSurvival-gridLost];
scalar["fixed_q_reference_energy_survival"]=FullSimplify[gridU-gridU gridSurvival-gridLost gridU/gridN];
scalar["fixed_q_local_energy_ledger"]=FullSimplify[gridR gridU(1-gridSurvival)-gridBinding-gridHeat];
scalar["fixed_q_freeflight_geometry_work"]=FullSimplify[gridR gridU-gridRnew gridU-(gridR-gridRnew)gridU];
scalar["fixed_q_total_source_then_absorb"]=FullSimplify[gridR gridU-gridR gridU gridSurvival-gridHeat-gridBinding];
res=<|"runtime"->ToString[System`$Version,InputForm],"scalar"->scalar,"tensor"->tensor,
 "all_zero"->And@@(TrueQ[#===0]&/@Flatten[Join[Values[scalar],Values[tensor]]]),
 "scope"->"C5 fixed-q source injection and frozen reaction number/reference-energy conservation; not coupled chemistry"|>;
Export["CAS_RESULT.json",res,"RawJSON"];
Print[ExportString[res,"RawJSON"]];
If[!res["all_zero"],Exit[7]];
