+#[cfg(test)]
+mod compensation_recovery_test {
+    use super::*;
+    #[test]
+    fn nonzero_energy_roundoff_is_preserved() {
+        let c = PairedConfig {
+            spectral_subdivisions: 8,
+            n_mu: 8,
+            n_phi: 16,
+        };
+        let mut state = paired_initial(&c).unwrap();
+        state.energy_comp = -1.3877787807814457e-16;
+        let dir = std::env::temp_dir().join(format!("rei-energy-comp-{}", std::process::id()));
+        fs::create_dir(&dir).unwrap();
+        let path = dir.join("checkpoint.dat");
+        fs::write(&path, checkpoint(&c, &state, 0, 0, 3.125e8, 0, [0.; 3])).unwrap();
+        let (recovered, _, _, _, _, _) = read_checkpoint(&path, &c).unwrap();
+        assert_eq!(recovered.energy_comp.to_bits(), state.energy_comp.to_bits());
+        fs::remove_dir_all(dir).unwrap();
+    }
 }
 
