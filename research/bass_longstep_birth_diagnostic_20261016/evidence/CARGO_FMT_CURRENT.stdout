+fn hat(x: f64, nodes: &[f64], j: usize) -> f64 {
+    if j == 0 {
+        if x <= nodes[0] {
+            1.0
+        } else if x >= nodes[1] {
+            0.0
+        } else {
+            (nodes[1] - x) / (nodes[1] - nodes[0])
+        }
+    } else if j + 1 == nodes.len() {
+        if x >= nodes[j] {
+            1.0
+        } else if x <= nodes[j - 1] {
+            0.0
+        } else {
+            (x - nodes[j - 1]) / (nodes[j] - nodes[j - 1])
+        }
+    } else if x <= nodes[j - 1] || x >= nodes[j + 1] {
+        0.0
+    } else if x <= nodes[j] {
+        (x - nodes[j - 1]) / (nodes[j] - nodes[j - 1])
+    } else {
+        (nodes[j + 1] - x) / (nodes[j + 1] - nodes[j])
+    }
 }
