+    let s = HHeState {
+        fractions: x,
+        u_erg_cm3: 1.5 * m.kb_erg_k * t * (nh + nhe + ne),
+        photon_cm3: [2e-5, 2e-6, 2e-7],
+        escaped_erg_cm3: 0.0,
+    };
+    (m, s)
 }
 fn close(a: f64, b: f64) {
