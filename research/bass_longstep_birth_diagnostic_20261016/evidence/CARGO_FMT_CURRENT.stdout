+fn cumulative(s: &PairedState, c: &PairedConfig) -> io::Result<[f64; 2]> {
+    let nodes = energy_nodes(c).map_err(ioerr)?;
+    let n = s.photons.iter().sum::<f64>() + s.lower_guard_n.iter().sum::<f64>();
