+    let ne_dot = m.n_h_cm3 * e.fraction_rate_s[0]
+        + m.n_he_cm3 * (e.fraction_rate_s[1] + 2.0 * e.fraction_rate_s[2]);
+    assert!(ne_dot.abs() <= 4e-16 * e.event_rate_cm3_s);
 }
