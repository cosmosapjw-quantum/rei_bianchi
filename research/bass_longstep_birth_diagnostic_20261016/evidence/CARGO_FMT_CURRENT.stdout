+    for t in [1000.0, 5000.0, 1e7] {
+        assert_eq!(a.coefficient_cm3_s(t).unwrap(), 1e-14);
+    }
+    for t in [200.0, 5000.0, 10000.0] {
+        assert_eq!(b.coefficient_cm3_s(t).unwrap(), 1.7e-13);
+    }
+    close(
+        b.coefficient_cm3_s(5000.0).unwrap() / a.coefficient_cm3_s(5000.0).unwrap(),
+        17.0,
+    );
 }
