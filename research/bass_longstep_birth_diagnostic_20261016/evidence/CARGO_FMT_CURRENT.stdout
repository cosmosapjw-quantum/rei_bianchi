+    let b = connected_cell(input(4e-4, 0.9)).unwrap();
+    let e = ensemble(&[(0.4, a), (0.6, b)]).unwrap();
+    let f = ensemble(&[(4.0, a), (6.0, b)]).unwrap();
+    unit(e.x_mass, f.x_mass);
