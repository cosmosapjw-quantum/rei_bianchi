+fn hat_at(x: f64, nodes: &[f64], j: usize) -> Result<Interval, ForwardError> {
+    if j == 0 {
+        if x <= nodes[0] {
+            return p(1.0);
+        }
+        if x >= nodes[1] {
+            return p(0.0);
+        }
+        return div(sub(p(nodes[1])?, p(x)?)?, sub(p(nodes[1])?, p(nodes[0])?)?);
+    }
+    if j + 1 == nodes.len() {
+        if x <= nodes[j - 1] {
+            return p(0.0);
+        }
+        if x >= nodes[j] {
+            return p(1.0);
+        }
+        return div(
+            sub(p(x)?, p(nodes[j - 1])?)?,
+            sub(p(nodes[j])?, p(nodes[j - 1])?)?,
+        );
+    }
+    if x <= nodes[j - 1] || x >= nodes[j + 1] {
+        return p(0.0);
+    }
+    if x == nodes[j] {
+        return p(1.0);
+    }
+    if x < nodes[j] {
+        div(
+            sub(p(x)?, p(nodes[j - 1])?)?,
+            sub(p(nodes[j])?, p(nodes[j - 1])?)?,
+        )
+    } else {
+        div(
+            sub(p(nodes[j + 1])?, p(x)?)?,
+            sub(p(nodes[j + 1])?, p(nodes[j])?)?,
+        )
+    }
 }
