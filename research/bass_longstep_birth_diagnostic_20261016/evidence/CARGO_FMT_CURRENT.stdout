+fn main() {
+    let stdin = io::stdin();
+    let mut stdout = io::BufWriter::new(io::stdout());
+    for line in stdin.lock().lines() {
+        match line {
+            Ok(line) => {
+                let response = run(&line)
+                    .unwrap_or_else(|e| format!("{{\"ok\":false,\"error\":\"{}\"}}", e.code()));
+                writeln!(stdout, "{}", response).unwrap();
+                stdout.flush().unwrap();
+            }
+            Err(_) => break,
+        }
     }
 }
 
