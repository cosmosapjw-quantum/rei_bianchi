+    let mutant =
+        i.scale_factor.powi(3) * i.hubble_s * i.photon_energy_ev[0] * i.edge_n_per_cm3_ev[0];
+    near(c.photon.edge_flux_comoving_cm3_s[0], exact, exact);
+    assert!((mutant - exact).abs() > 0.4 * exact);
