AW_20261016.tar.gz?rlkey=nul0936nts7xi3prvw0bghgjx&dl=0).\n- Code/results archive SHA-256: `622a3d942b3abe8f0b36413edbca11b31e0a4901055389828fbf0d6312600270`; [Drive](https://drive.google.com/file/d/1o_U3A3SOzMLGEQ7gij0UQIPcWKqDrSby/view), [Dropbox](https://www.dropbox.com/scl/fi/7mx343yo25pz3pwdpycqy/V10_CODE_RESULTS_20261016.tar.gz?rlkey=jyz8wffqjnnrlfqgz1e675cu1&dl=0).\n","labels":[],"milestone":null,"active_lock_reason":null,"created_at":"2026-10-16T04:02:47Z","updated_at":"2026-10-16T04:04:42Z","closed_at":null,"merged_at":null,"merge_commit_sha":"a005548388af56144244aa2b68e514119eb0238c","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"cosmosapjw-quantum:research/rei-lrs-v10-native-source-clocks-20261016","ref":"research/rei-lrs-v10-native-source-clocks-20261016","repo":{"id":1322787769,"node_id":"R_kgDOTtgjuQ","name":"rei_bianchi","full_name":"cosmosapjw-quantum/rei_bianchi","owner":{"login":"cosmosapjw-quantum","id":58155957,"node_id":"MDQ6VXNlcjU4MTU1OTU3","avatar_url":"https://avatars.githubusercontent.com/u/58155957?v=4","gravatar_id":"","url":"https://api.github.com/users/cosmosapjw-quantum","html_url":"https://github.com/cosmosapjw-quantum","followers_url":"https://api.github.com/users/cosmosapjw-quantum/followers","following_url":"https://api.github.com/users/cosmosapjw-quantum/following{/other_user}","gists_url":"https://api.github.com/users/cosmosapjw-quantum/gists{/gist_id}","starred_url":"https://api.github.com/users/cosmosapjw-quantum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cosmosapjw-quantum/subscriptions","organizations_url":"https://api.github.com/users/cosmosapjw-quantum/orgs","repos_url":"https://api.github.com/users/cosmosapjw-quantum/repos","events_url":"https://api.github.com/users/cosmosapjw-quantum/events{/privacy}","received_events_url":"https://api.github.com/users/cosmosapjw-quantum/received_events","type":"User","user_view_type":"public","site_admin":false