{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rei:ssot:dag:v2",
  "type": "object",
  "required": [
    "schema",
    "date",
    "nodes",
    "source_proposal_enumerated_nodes"
  ],
  "properties": {
    "schema": {
      "const": "rei.ssot.dag.v2"
    },
    "date": {
      "type": "string"
    },
    "source_proposal_enumerated_nodes": {
      "const": 21
    },
    "nodes": {
      "type": "array",
      "minItems": 21,
      "items": {
        "type": "object",
        "required": [
          "id",
          "depends_on",
          "goal",
          "inputs",
          "outputs",
          "physics_acceptance",
          "numerical_acceptance",
          "status",
          "scientific_claim",
          "on_pass",
          "execution_budget"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "goal": {
            "type": "string",
            "minLength": 5
          },
          "status": {
            "type": "string"
          },
          "scientific_claim": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}