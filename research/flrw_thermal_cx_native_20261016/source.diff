+        calls.set(calls.get()+1);
+        if calls.get()==200 {Err(ThermalCxError::FieldFailure("SYNTHETIC_PROVIDER_FAILURE"))}
+        else {Ok((0.2*t/10.0,0.2*t/10.0))}
