+    def test_strict_hex_endpoint_and_capped_birth_boundary(self):
+        x=float.fromhex('-0x1.8571600faf24ap+1')
+        end=float.fromhex('-0x1.8571600faf247p+1')
+        h=end-x; midpoint=x+h/2
+        self.assertEqual(h.hex(),'0x1.8000000000000p-50')
+        self.assertGreater(midpoint+h/2,end) # actual frozen defect falsifier
+        seen=[]
+        def strict(t,v):
+            self.assertLessEqual(t,end)
+            seen.append(t)
+            return (0.,)*len(v)
+        fine,e=transaction(strict,x,self.v,h,self.d,Counters(),endpoint=end)
+        self.assertEqual(seen,[x,end,x,midpoint,midpoint,end])
+        self.assertEqual(fine,self.v);self.assertEqual(e,0.)
+        # Same short capped transaction ends at a birth, then injects once.
+        seen.clear(); initial=self.v+(0.,0.)
+        domain=Domain(.08,.001,((4,5,2.,4.),))
+        out=integrate(strict,initial,domain,[x,end],[end],[(0.,0.,0.,0.,.125,.375)],initial_h=1e-4)
+        self.assertEqual(seen,[x,end,x,midpoint,midpoint,end])
+        self.assertEqual(out['x'],end)
+        self.assertEqual(out['state'],self.v+(.125,.375))
+        self.assertEqual((out['counts'].accepted,out['counts'].births),(1,1))
