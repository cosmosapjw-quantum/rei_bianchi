+use axbi_temperature_rate_table_benchmark::{
+    temperature,
+    thermal_adapter::{igm_point_rhs, IgmPhotoInput},
+    Table,
+};
+use rei_microphysics::{
+    axbi_rates::AxbiProvider,
+    igm_rates::{igm_rates, IgmRates},
+    igm_state::IgmGasState,
+    igm_thermal, ForwardError,
+};
+use std::{fs, hint::black_box, path::PathBuf, time::Instant};
+fn cpu() -> f64 {
+    fs::read_to_string("/proc/self/schedstat")
+        .ok()
+        .and_then(|s| s.split_whitespace().next()?.parse::<f64>().ok())
+        .unwrap_or(0.0)
+        / 1e9
+}
+fn table_point(
+    table: &Table,
+    s: &IgmGasState,
+) -> Result<
+    (
+        f64,
+        IgmRates,
+        axbi_temperature_rate_table_benchmark::thermal_adapter::IgmPointRhs,
+    ),
+    ForwardError,
+> {
+    let t = s.eos(1e-4, 8e-6)?.temperature_k;
+    let rhs = igm_point_rhs(
+        s,
+        1e-4,
+        8e-6,
+        1e-17,
+        2.7255,
+        IgmPhotoInput {
+            gamma_s: [1e-14, 2e-14, 3e-14],
+            heat_erg_per_absorber_s: [1e-26, 2e-26, 3e-26],
+        },
+        |q| table.query(q),
+    )?;
+    let rates = table.query(t)?;
+    Ok((t, rates, rhs))
+}
+fn main() {
+    if let Err(e) = run() {
+        eprintln!("{e}");
+        std::process::exit(2)
+    }
+}
+fn run() -> Result<(), String> {
+    let args: Vec<_> = std::env::args().collect();
+    if args.len() != 7 || args[1] != "--contract" || args[3] != "--table" || args[5] != "--output" {
+        return Err("ARGS".into());
+    }
+    if fs::read(&args[2]).map_err(|e| e.to_string())?
+        != include_bytes!("../AUTHORITY_CONTRACT.json")
+    {
+        return Err("CONTRACT_BYTES".into());
+    }
+    let path = PathBuf::from(&args[4]);
+    let start = Instant::now();
+    let cp = cpu();
+    let table = Table::load(&path)?;
+    let load_wall = start.elapsed().as_secs_f64();
+    let load_cpu = cpu() - cp;
+    let local = fs::read_to_string(
+        path.parent()
+            .unwrap()
+            .parent()
+            .unwrap()
+            .join("raw/local_test_counts.json"),
+    )
+    .map_err(|e| e.to_string())?;
+    let nums: Vec<u64> = local
+        .split(|c: char| !c.is_ascii_digit())
+        .filter(|s| !s.is_empty())
+        .map(|s| s.parse().unwrap())
+        .collect();
+    if nums.len() < 3 {
+        return Err("LOCAL_COUNTS".into());
+    }
+    let mut direct = nums[0];
+    let mut lookups = nums[1];
+    let mut rates: Vec<f64> = (0..257).map(|j| temperature(j * 65536 / 256)).collect();
+    let saved = fs::read(path.parent().unwrap().join("saved_temperatures.bin"))
+        .map_err(|e| e.to_string())?;
+    if saved.len() != 2048 {
+        return Err("SAVED_TEMPERATURE_DIMENSION".into());
+    }
+    for b in saved.chunks_exact(8) {
+        rates.push(f64::from_bits(u64::from_le_bytes(b.try_into().unwrap())))
+    }
+    for &t in &rates {
+        let a = igm_rates(t).map_err(|e| format!("{e:?}"))?;
+        direct += 1;
+        let b = table.query(t).map_err(|e| format!("{e:?}"))?;
+        let av = axbi_temperature_rate_table_benchmark::columns(&a);
+        let bv = axbi_temperature_rate_table_benchmark::columns(&b);
+        for k in 0..15 {
+            if (av[k] - bv[k]).abs() > 1e-300 + 1e-6 * av[k].abs() {
+                return Err(format!(
+                    "PRETIMING_COEFFICIENT t_bits={} k={k} a={} b={}",
+                    t.to_bits(),
+                    av[k],
+                    bv[k]
+                ));
+            }
+        }
+    }
+    let p = IgmPhotoInput {
+        gamma_s: [1e-14, 2e-14, 3e-14],
+        heat_erg_per_absorber_s: [1e-26, 2e-26, 3e-26],
+    };
+    let mut rhs_states = Vec::new();
+    for j in 1..=64 {
+        let t = temperature(j * 65536 / 65);
+        let s = IgmGasState::from_temperature([0.5, 0.25, 0.25], 1e-4, 8e-6, t)
+            .map_err(|e| format!("{e:?}"))?;
+        let a = AxbiProvider
+            .point(&s, 1e-4, 8e-6, 1e-17, 2.7255, p)
+            .map_err(|e| format!("{e:?}"))?;
+        direct += 2;
+        let b = table_point(&table, &s).map_err(|e| format!("{e:?}"))?;
+        let scale = a.rhs.temperature_dt_k_s.abs() + 1e-300;
+        if (a.rhs.temperature_dt_k_s - b.2.temperature_dt_k_s).abs() > 2e-6 * scale {
+            return Err(format!(
+                "PRETIMING_RHS t_bits={} a={} b={}",
+                t.to_bits(),
+                a.rhs.temperature_dt_k_s,
+                b.2.temperature_dt_k_s
+            ));
+        }
+        rhs_states.push(s)
+    }
+    if direct > 1_900_000 || lookups > 7_900_000 {
+        return Err("INSUFFICIENT_RESERVED_QUOTA".into());
+    }
+    let mut lines = Vec::new();
+    for rep in 0..3 {
+        for mode in if rep % 2 == 0 {
+            [0, 1, 2, 3]
+        } else {
+            [1, 0, 3, 2]
+        } {
+            let st = Instant::now();
+            let ct = cpu();
+            let mut checksum = 0.0;
+            let mut count = 0;
+            for _ in 0..8 {
+                if mode < 2 {
+                    for &t in &rates {
+                        let v = if mode == 0 {
+                            direct += 1;
+                            igm_rates(black_box(t))
+                        } else {
+                            table.query(black_box(t))
+                        }
+                        .map_err(|e| format!("{e:?}"))?;
+                        checksum += black_box(v.ci_cm3_s[0] + v.rr_cm3_s[0] + v.freefree_erg_cm3_s);
+                        count += 1
+                    }
+                } else {
+                    for s in &rhs_states {
+                        let v = if mode == 2 {
+                            direct += 2;
+                            AxbiProvider
+                                .point(black_box(s), 1e-4, 8e-6, 1e-17, 2.7255, p)
+                                .map(|q| q.rhs)
+                        } else {
+                            table_point(&table, black_box(s)).map(|q| q.2)
+                        }
+                        .map_err(|e| format!("{e:?}"))?;
+                        checksum += black_box(
+                            v.temperature_dt_k_s
+                                + v.w_dt_erg_per_h_s
+                                + v.fraction_dt.iter().sum::<f64>(),
+                        );
+                        count += 1
+                    }
+                }
+            }
+            let wall = st.elapsed().as_secs_f64();
+            let c = cpu() - ct;
+            lines.push(format!("{{\"rep\":{rep},\"mode\":{mode},\"count\":{count},\"wall_s\":{wall},\"cpu_s\":{c},\"checksum\":{checksum}}}"));
+            black_box(checksum)
+        }
+    }
+    lookups += table.lookup.get();
+    direct += table.direct.get();
+    if direct > 2_000_000 || lookups > 8_000_000 {
+        return Err(format!("QUOTA direct={direct} lookups={lookups}"));
+    }
+    let bytes = fs::metadata(&path).map_err(|e| e.to_string())?.len();
+    let output=format!("{{\"status\":\"COMPONENT_GATES_PASS\",\"load_wall_s\":{load_wall},\"load_cpu_s\":{load_cpu},\"artifact_bytes\":{bytes},\"direct_cumulative\":{direct},\"lookups_cumulative\":{lookups},\"fallback_remote\":{},\"timing\":[{}],\"whole_driver_speedup\":\"NOT_MEASURED\",\"scientific_admission\":\"NOT_ISSUED\"}}\n",table.fallback.get(),lines.join(","));
+    fs::write(&args[6], output).map_err(|e| e.to_string())?;
+    Ok(())
+}
 
