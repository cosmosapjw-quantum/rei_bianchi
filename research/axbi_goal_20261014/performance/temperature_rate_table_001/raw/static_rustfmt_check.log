+fn err(g: &str, t: f64, k: usize, a: f64, b: f64) -> String {
+    format!(
+        "{{\"gate\":\"{g}\",\"t_bits\":{},\"field\":{k},\"reference\":{a:e},\"candidate\":{b:e}}}",
+        t.to_bits()
+    )
