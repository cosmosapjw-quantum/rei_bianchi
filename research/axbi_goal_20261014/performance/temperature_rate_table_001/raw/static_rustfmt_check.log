+fn frozen_table_matrix() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR"));
+    let table = Table::construct().unwrap();
+    let path = root.join("data/rates.bin");
+    table.save(&path).unwrap();
+    assert!(std::fs::metadata(&path).unwrap().len() <= 33554432);
+    let loaded = Table::load(&path).unwrap();
+    let repo = root.ancestors().nth(4).unwrap();
+    let literal =
+        repo.join("rust/rei_microphysics/tests/data/igm_grackle/grackle_literal_reference.csv");
+    let samples=[repo.join("research/axbi_goal_20261014/report/full_progress_32d11e733155/snapshot_20261014T083357015083Z/ZERO/history.csv.complete_prefix"),repo.join("research/axbi_goal_20261014/report/full_progress_32d11e733155/snapshot_20261014T083357015083Z/SHEAR_PLUS/history.csv.complete_prefix")];
+    let executable =
+        std::path::Path::new(env!("CARGO_BIN_EXE_axbi_temperature_rate_table_benchmark"));
+    assert!(
+        executable.is_file(),
+        "normal release benchmark executable missing"
+    );
+    let mut saved_t = Vec::new();
+    for sample in &samples {
+        let text = std::fs::read_to_string(sample).unwrap();
+        let mut lines = text.lines();
+        let head: Vec<_> = lines.next().unwrap().split(',').collect();
+        let col = head.iter().position(|x| *x == "temperature_K").unwrap();
+        let rows: Vec<_> = lines.collect();
+        for j in 0..128 {
+            let idx = j * (rows.len() - 1) / 127;
+            let t: f64 = rows[idx].split(',').nth(col).unwrap().parse().unwrap();
+            saved_t.extend_from_slice(&t.to_bits().to_le_bytes());
+        }
+    }
+    std::fs::write(root.join("data/saved_temperatures.bin"), saved_t).unwrap();
+    let r = validate(
+        &loaded,
+        &literal,
+        &[samples[0].as_path(), samples[1].as_path()],
+    )
+    .unwrap();
+    std::fs::write(root.join("raw/local_test_counts.json"),format!("{{\"direct\":{},\"lookups\":{},\"fallback\":{},\"rhs_cases\":{},\"slopes\":{},\"saved\":{}}}\n",r.direct,r.lookups,r.fallback,r.rhs_cases,r.slopes,r.saved)).unwrap();
