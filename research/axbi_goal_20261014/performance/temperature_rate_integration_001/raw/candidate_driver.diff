+fn write_surface(driver:&Driver, state:&DriverState, out:&Path, id:usize, index:&mut impl Write)->Result<(),ForwardError>{
+    let nh=driver.n_h0_cm3/state.a.powi(3);
+    let nhe=driver.n_he0_cm3/state.a.powi(3);
+    let eos=state.gas.eos(nh,nhe)?;
+    let time=driver.background.point_at_scale(state.a)?.time_s;
+    let (coeff,lookup,fallback)=driver.rate_provider.counts();
+    let row=format!("{id},{:.17e},{:.17e},{:.17e},{:.17e},{:.17e},{},{},{},{},{},{},{},{}\n",
+        state.a,time,eos.temperature_k,eos.electron_density_cm3,w_erg_per_h_to_ev(state.gas.w_erg_per_h)?,
+        state.accepted,state.attempts,state.rejects,state.comparisons,state.rhs_evaluations,coeff,lookup,fallback);
+    guard_output_bytes_with_limit(out,(row.len()+driver.checkpoint_text(state)?.len()) as u64,driver.config.scientific_output_budget_bytes()?)?;
+    index.write_all(row.as_bytes()).map_err(ioerr)?;
+    index.flush().map_err(ioerr)?;
+    driver.save_checkpoint_budget(out,&out.join(format!("surface_{id:02}.txt")),state)?;
+    Ok(())
+}
