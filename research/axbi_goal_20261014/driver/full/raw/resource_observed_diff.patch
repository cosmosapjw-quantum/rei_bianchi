diff --git a/rust/rei_microphysics/tests/axbi_driver.rs b/rust/rei_microphysics/tests/axbi_driver.rs
index 3155a893..48afc5e6 100644
--- a/rust/rei_microphysics/tests/axbi_driver.rs
+++ b/rust/rei_microphysics/tests/axbi_driver.rs
@@ -325,3 +325,66 @@ fn sparse_full_spectra_keep_each_abundance_and_align_terminal_resume_and_cap() {
     drop(f);
     std::fs::remove_dir_all(root).unwrap();
