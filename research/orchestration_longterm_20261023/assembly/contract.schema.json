{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orchestration:contract:v1",
  "title": "Source-preserving orchestration DAG",
  "type": "object",
  "required": [
    "schema",
    "authorities",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "ORCHESTRATION_DAG_V1"
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "document"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "document": {
            "type": "object"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "repository",
          "authority",
          "authority_pointer",
          "contract",
          "local_dependencies",
          "external_dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string"
          },
          "authority_pointer": {
            "type": "string"
          },
          "contract": {
            "type": "object"
          },
          "local_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external_dependencies": {
            "type": "array"
          }
        }
      }
    }
  },
  "$comment": "Scientific fields remain authority-defined. Checker tests exact source equality, source references, duplicate IDs and local cycles; it does not judge new physics or turn plans into passed results."
}
