+            'child_system_cpu_s': after.ru_stime - before.ru_stime,
+            'child_total_cpu_s': (after.ru_utime - before.ru_utime) + (after.ru_stime - before.ru_stime),
+            'returncode': returncode, 'timed_out': timeout, 'launch_error': launch_error,
