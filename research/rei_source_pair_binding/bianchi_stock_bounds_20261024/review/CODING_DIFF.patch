+        handle.write('\n')
+    before = resource.getrusage(resource.RUSAGE_CHILDREN)
+    start = time.monotonic()
+    stdout = b''
+    stderr = b''
+    process = None
+    timeout = False
+    launch_error = None
+    returncode = None
+    try:
+        process = subprocess.Popen(command, cwd=HERE, stdout=subprocess.PIPE,
